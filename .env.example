# Copy to .env for local dev:  cp .env.example .env   (then fill in the values)
# In production, set these in Railway → Service → Variables (do NOT commit real values).

# Bot token from the Discord Developer Portal (Bot → Reset Token). Keep secret.
DISCORD_TOKEN=

# The channel the bot posts in and listens to. Right-click the channel → Copy Channel ID
# (needs Developer Mode: User Settings → Advanced → Developer Mode).
CHANNEL_ID=

# Optional: a channel where each gratitude entry is mirrored as a per-day card (edited
# in place when you edit that day's entry) — your scrollable journal archive. Leave unset
# to disable. Use a PRIVATE channel (entries are personal); the bot needs View Channel +
# Send Messages there. Right-click the channel → Copy Channel ID.
# GRATITUDE_CHANNEL_ID=

# Your Discord user ID — used for the @-mention and to filter whose replies count.
# Right-click your own name → Copy User ID.
USER_ID=

# IANA timezone — drives both schedules and the local "day" for streaks.
# America/Los_Angeles = Pacific time; tracks PST/PDT automatically.
TZ=America/Los_Angeles

# Per-slot check-in times, 24h local time (HH:MM). Each pings you with just that
# slot's habits: morning at 7am, afternoon at noon, evening at 5pm (Pacific).
MORNING_TIME=07:00
AFTERNOON_TIME=12:00
EVENING_TIME=17:00

# End-of-day catch-up nudge (HH:MM). Only sends if the day's list isn't complete. 8pm Pacific.
REMINDER_TIME=20:00

# Where state.json is stored. In Railway, mount a Volume and point this at it (e.g. /data).
# For local dev, use a folder you can inspect, e.g. ./data
DATA_DIR=/data

# ---- Samsung Health ingest (optional) — auto-checks off steps / water / meditate over HTTP ----
# Leave INGEST_TOKEN unset to disable the HTTP endpoints entirely (the bot runs fine without them).
# When set, the bot exposes POST /ingest and GET /status, both requiring:
#   Authorization: Bearer <INGEST_TOKEN>
# Generate a long random secret and set it here and in your phone automation.
# INGEST_TOKEN=

# Port the ingest server listens on. Railway injects PORT automatically; 3000 is a local default.
PORT=3000

# Goals that auto-check the matching habit for the day. Values pushed are that day's totals.
STEPS_GOAL=10000           # steps ≥ this → checks off "steps"
WATER_GOAL_GALLONS=1       # water (in gallons) ≥ this → checks off "water"
MEDITATION_MINUTES=1       # meditation minutes ≥ this (any logged session) → checks off "meditate"

# Optional: set to 1 to fire one prompt immediately at startup (handy for testing). Leave unset in prod.
# SEND_NOW=1

# ---- Audible integration (optional) — auto-checks off "reading" from real listening time ----
# Leave AUDIBLE_CREDENTIALS unset to disable the whole integration; the bot runs fine without it.
# Generate credentials locally with:  npm run setup:audible
# Then paste the saved JSON here (one line) for Railway; the bot writes it to the volume and
# auto-refreshes it from then on.
# AUDIBLE_CREDENTIALS=
#
# Audible marketplace locale (com=US, co.uk, de, fr, it, es, ca, com.au, in, co.jp). Default com.
AUDIBLE_LOCALE=com
#
# Minutes of listening that count the reading habit as done. Default 30.
READING_MINUTES=30
#
# Optional: override where credentials are stored (defaults to DATA_DIR/audible-credentials.json).
# AUDIBLE_CREDENTIALS_FILE=
